# ====================================================================
# Sun-HSK — Root .gitignore
# ====================================================================

# --------------------------------------------------------------------
# 1. Environment Variables & Secrets (BẢO MẬT - TUYỆT ĐỐI KHÔNG PUSH)
# --------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.p12
*.jks
*.keystore
*secret*
*credentials*
application-local.yml
application-local.properties
application-secret.yml

# --------------------------------------------------------------------
# 2. Dependencies & Package Managers (Dung lượng lớn, tự tải lại được)
# --------------------------------------------------------------------
# Node.js / Frontend
node_modules/
/sun-fe/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------------------------
# 3. Build Outputs & Compiled Binaries (File sinh tự động từ source)
# --------------------------------------------------------------------
# Java / Maven Backend
target/
/sun-be/target/
*.class
*.jar
*.war
*.ear
*.nar

# Frontend Build
build/
/sun-fe/build/
dist/
/sun-fe/dist/
out/
.next/
coverage/
/sun-fe/coverage/

# --------------------------------------------------------------------
# 4. IDEs, Editors & Tool Configurations (Cấu hình riêng của máy cá nhân)
# --------------------------------------------------------------------
# IntelliJ IDEA / WebStorm / JetBrains
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# VS Code
.vscode/
*.code-workspace
.history/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# --------------------------------------------------------------------
# 5. OS Generated Files & Temp Files
# --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*.tmp
*.temp
*.swp
*~
*.bak

# --------------------------------------------------------------------
# 6. Logs & Diagnostics
# --------------------------------------------------------------------
*.log
logs/
/sun-be/logs/
*.pid
*.seed
*.pid.lock
.report/

# --------------------------------------------------------------------
# 7. AI Agents & IDE Tooling
# --------------------------------------------------------------------
.agents/
.claude/
.codex/
.cursor/
.gemini/
.impeccable/
**/.impeccable/
sun-fe/*.cjs
test-*.json
test_*.py
scratch_*.py
